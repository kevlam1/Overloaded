{
  "name": "overloaded",
  "private": true,
  "type": "module",
  "description": "Overloaded: a browser tabletop for playing a card game with friends. The page; the database rules and their tests live in backend/.",
  "scripts": {
    "dev": "vite",
    "cards": "node scripts/build-card-list.mjs",
    "build": "node scripts/build-card-list.mjs && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-all.mjs",
    "test:quick": "node scripts/test-all.mjs --quick",
    "test:live": "node scripts/test-all.mjs --live"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "clsx": "2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "1.81.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "vite": "^8.3.5"
  }
}
