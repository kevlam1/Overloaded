{
  "name": "overloaded",
  "private": true,
  "type": "module",
  "description": "Overloaded: a browser tabletop for playing a card game with friends. The page; the database rules and their tests live in backend/.",
  "scripts": {
    "dev": "vite",
    "cards": "node scripts/build-card-list.mjs",
    "build": "node scripts/build-card-list.mjs && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-all.mjs",
    "test:quick": "node scripts/test-all.mjs --quick",
    "test:live": "node scripts/test-all.mjs --live"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
