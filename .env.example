# Copy this file to .env (which is gitignored) and fill in the values from the Firebase console:
# Project settings, Your apps, the web app, the firebaseConfig block.
# These identify the project and are public by design (Firebase's docs: security comes from the
# database rules, not from hiding these), but the rule in CLAUDE.md is still: no values in the repo.
# Only the five fields live play needs are listed. The console also shows storageBucket,
# messagingSenderId and measurementId; we don't use them, so they are not copied.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
